PORT=3000
JWT_SECRET=change-me
JWT_EXPIRY_SECONDS=3600
S3_ENDPOINT=https://your-upcloud-endpoint
S3_STS_ENDPOINT=https://your-upcloud-endpoint:4443/sts
S3_REGION=europe-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
S3_UPLOAD_ROLE_ARN=urn:ecs:iam::your-account-id:role/your-upload-role
PUBLISH_INTERVAL_SECONDS=300
INBOX_POLL_INTERVAL_SECONDS=30
INBOX_PAGE_SIZE=50
